# AgroChain DApp • Configuração de Ambiente (Next.js)
# Copie para .env.local e ajuste os valores.
# Variáveis precisam do prefixo NEXT_PUBLIC_ para ficarem disponíveis no browser.

# URL base da API de Compliance (IA) — usado em /compliance
NEXT_PUBLIC_COMPLIANCE_API_URL=http://localhost:8001

# Endereço do contrato NFT AgroChainCertNFT (Sepolia)
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x444853d891F884EbD1b69Dc6F044a2Ff4f9C9269

# RPC público da Sepolia (fallback para consultas on-chain)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Endereço do contrato Marketplace (após deploy)
# NEXT_PUBLIC_MARKETPLACE_ADDRESS=0x...

# Endereço do contrato AgroChainPayments (escrow)
# NEXT_PUBLIC_PAYMENTS_ADDRESS=0x...
