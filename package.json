{
  "name": "agrochain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "blockchain:compile": "hardhat compile",
    "zk:setup:dev": "bash blockchain/scripts/setup-zk-dev.sh",
    "zk:setup:prod": "node blockchain/scripts/setup-zk-production.mjs",
    "zk:prove": "node blockchain/scripts/prove-certificate.mjs",
    "zk:emit": "node blockchain/scripts/emit-certificate.mjs",
    "test:certification": "hardhat run blockchain/scripts/test-certification.mjs",
    "deploy:amoy": "hardhat run blockchain/scripts/deploy-certification.mjs --network polygonAmoy",
    "deploy:sepolia": "node blockchain/scripts/deploy-sepolia.mjs",
    "test:cafeswap": "npx hardhat test \"blockchain/tests/CafeToken.test.js\" \"blockchain/tests/CoffeeCacaoSwapFactory.test.js\" \"blockchain/tests/CoffeeCacaoSwapPool.test.js\" \"blockchain/tests/CoffeeCacaoSwapRouter.test.js\" \"blockchain/tests/CoffeeCacaoFarm.test.js\" \"blockchain/tests/CafeGovernance.test.js\" --network hardhatMainnet",
    "deploy:cafeswap:amoy": "hardhat run blockchain/scripts/deploy-cafeswap.mjs --network polygonAmoy",
    "deploy:cafeswap:local": "hardhat run blockchain/scripts/deploy-cafeswap.mjs --network hardhat",
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "npx cap sync android && cd android && ./gradlew assembleRelease",
    "apk:build": "npm run android:sync && npm run android:build"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "AgroChain zero-knowledge certificate, soulbound NFT and utility token contracts",
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@nomicfoundation/hardhat-ethers": "^4.2.0",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.12",
    "@nomicfoundation/hardhat-mocha": "^4.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@openzeppelin/contracts": "^5.6.1",
    "chai": "^6.3.0",
    "circom2": "^0.2.23",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "ethers": "^6.17.0",
    "fast-check": "^4.10.2",
    "hardhat": "^3.18.1",
    "snarkjs": "^0.7.6",
    "solc": "^0.8.37"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  }
}
